---
import type { CollectionEntry } from "astro:content";
import { formatCareerDate } from "../lib/dates";
import { withBase } from "../lib/urls.mjs";
interface Props {
  entry: CollectionEntry<"career">;
  headingLevel?: "h2" | "h3";
}
const { entry, headingLevel: Heading = "h3" } = Astro.props;
const { company, role, start, end, summary, draft } = entry.data;
---

<article class="career-summary">
  <div class="entry-dates">
    {formatCareerDate(start)}
    <span aria-hidden="true"> — </span>
    <span class="sr-only"> to </span>
    {formatCareerDate(end)}
  </div>
  <div>
    <div class="entry-kicker">
      {company}
      {draft && <span class="draft-badge">Draft</span>}
    </div>
    <Heading class="summary-title">
      <a href={withBase(`/career/${entry.id}/`, import.meta.env.BASE_URL)}>
        {role}
      </a>
    </Heading>
    <p>{summary}</p>
  </div>
</article>
